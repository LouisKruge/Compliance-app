# Database (SQLite for dev; switch provider to postgresql in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: enables real AI generation for safety files & tender analysis.
# Without it, TenderFit falls back to its built-in regulation-skeleton templates.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
